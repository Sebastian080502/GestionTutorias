generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  firstName      String
  secondName     String
  lastName       String
  secondLastName String
  email          String   @unique
  password       String
  role           String
  createdAt      DateTime @default(now())
  active         Boolean  @default(true)
  lastLogin      DateTime @default(now())

  // Relaciones
  student        Student?
  teacher        Teacher?
}

model Student {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [idUser], references: [id])
  idUser    String   @unique
  programa  String
  semestre  String
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}

model Teacher {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [idUser], references: [id])
  idUser         String   @unique
  especialidad   String
  disponibilidad String
  createdAt      DateTime @default(now())
  active         Boolean  @default(true)
}

model Tutorial {
  id        String   @id @default(uuid())
  idStudent String
  idTeacher String
  fecha     DateTime
  hora      String
  estado    String
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}

model Report {
  id        String   @id @default(uuid())
  idTutoria String
  idStudent String
  idTeacher String
  fecha     DateTime
  contenido String
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}